/*
 * ui_client.c — 车机风格 AI 助手触屏界面 (RK1808)
 * ==================================================
 * 屏幕:   1024x600 DRM Framebuffer (BGRA, 4 bytes/pixel)
 * 触屏:   /dev/input/event2 (ABS_X / ABS_Y / BTN_TOUCH)
 * 功能:   录音 -> SCP 传输 -> 接收 AI 回复 -> 语音播报 -> LED 控制
 * 编译:   make ui_client  (aarch64 交叉编译, -lpthread -lDRMwrap -ldrm)
 *
 * 布局:
 *   [ 0-  70]  顶栏   — 标题 + 状态指示
 *   [70- 460]  主区域 — 两张大圆角卡片 (录音/发送)
 *   [460-520]  状态栏 — 颜色编码状态反馈 + 中文状态文字
 *   [520-600]  导航栏 — 底部导航图标 + 中文标签
 */

#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
