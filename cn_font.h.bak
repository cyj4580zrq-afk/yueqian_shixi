static int get_cn_char_index(uint32_t code) {
    int low = 0;
    int high = (int)(sizeof(cn_char_codes) / sizeof(cn_char_codes[0])) - 1;
    while (low <= high) {
        int mid = low + (high - low) / 2;
        if (cn_char_codes[mid] == code) {
            return mid;
        } else if (cn_char_codes[mid] < code) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    return -1; // Not found
}

